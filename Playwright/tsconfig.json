{
    "compilerOptions": {
      "target": "ESNext",
      "module": "CommonJS",
      "moduleResolution": "Node",
      "types": ["node", "playwright"],
      "esModuleInterop": true,
      "strict": true,
      "skipLibCheck": true,
      "resolveJsonModule": true
    },
    "include": [
      "playwright.config.ts",
      "tests/**/*.ts",
      "**/*.ts"
    ],
    "exclude": ["node_modules"]
  }
  